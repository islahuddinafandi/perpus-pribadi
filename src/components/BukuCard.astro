---
import type { Buku } from '../types/buku';
import StatusBadge from './StatusBadge.astro';
export interface Props { buku: Buku }
const { buku } = Astro.props;
const ringBorder: Record<string, string> = {
  'sedang-dibaca': 'ring-2 ring-blue-200',
  'sudah-dibaca':  '',
  'mau-dibaca':    '',
};
---

  href={`/buku/${buku.id}`}
  data-card
  data-judul={buku.judul}
  data-penulis={buku.penulis}
  data-kategori={buku.kategori}
  data-status={buku.status}
  class={`group bg-white rounded-xl border border-stone-100 overflow-hidden
    hover:shadow-md hover:-translate-y-0.5 transition-all duration-200
    ${ringBorder[buku.status]}`}
>
  <div class="aspect-[3/4] bg-stone-50 overflow-hidden">
    <img
      src={buku.cover_url}
      alt={buku.judul}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
      onerror="this.style.background='#f5f0eb'"
    />
  </div>
  <div class="p-3">
    <p class="text-xs text-stone-400 truncate mb-0.5">{buku.kategori}</p>
    <h2 class="text-sm font-medium leading-snug line-clamp-2 mb-1">{buku.judul}</h2>
    <p class="text-xs text-stone-400 truncate mb-2">{buku.penulis}</p>
    <StatusBadge status={buku.status} />
  </div>
</a>
