---
export interface Props {
  total: number; sudah: number; sedang: number; mau: number;
}
const { total, sudah, sedang, mau } = Astro.props;
---
<div class="grid grid-cols-4 gap-3 mb-8">
  <div class="bg-white rounded-xl border border-stone-100 px-4 py-3 text-center">
    <p class="text-2xl font-semibold">{total}</p>
    <p class="text-xs text-stone-400 mt-0.5">Total buku</p>
  </div>
  <div class="bg-emerald-50 rounded-xl border border-emerald-100 px-4 py-3 text-center">
    <p class="text-2xl font-semibold text-emerald-700">{sudah}</p>
    <p class="text-xs text-emerald-500 mt-0.5">Sudah dibaca</p>
  </div>
  <div class="bg-blue-50 rounded-xl border border-blue-100 px-4 py-3 text-center">
    <p class="text-2xl font-semibold text-blue-700">{sedang}</p>
    <p class="text-xs text-blue-500 mt-0.5">Sedang dibaca</p>
  </div>
  <div class="bg-stone-50 rounded-xl border border-stone-100 px-4 py-3 text-center">
    <p class="text-2xl font-semibold text-stone-500">{mau}</p>
    <p class="text-xs text-stone-400 mt-0.5">Mau dibaca</p>
  </div>
</div>
